# ORAYA backend — copy to .env and fill in. Never commit real secrets.

# Database. Local dev default (SQLite) works with no setup.
# The bundled versioned migration runner supports SQLite only.
DATABASE_URL=sqlite:///./oraya.db

# Auth — generate with: python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_DAYS=30

# Gemini — required for generated explanations, notes, quizzes and semantic comparison.
# Manual learning tools and lexical search work without a key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TUTOR_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Comma separated
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Where generated files (mp4, exports) are written
STORAGE_DIR=./storage

# Demo data and extractive AI fallbacks are opt-in only.
ALLOW_DEMO_AI=false
SEED_DEMO=false
STUDY_TIMEZONE=Asia/Kolkata

# Real scene-based video rendering (FFmpeg must be installed).
TTS_PROVIDER=macos
TTS_VOICE=Samantha
# Optional absolute binaries; PATH is used when blank.
FFMPEG_BIN_PATH=
FFPROBE_BIN_PATH=

# Ordered reasoning chain (legacy GEMINI_MODEL/TUTOR_MODEL remain accepted).
GEMINI_PRIMARY_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL_1=gemini-3.7-flash
GEMINI_FALLBACK_MODEL_2=gemini-3.8-flash
GEMINI_FALLBACK_MODEL_3=
AI_TIMEOUT_MS=180000
AI_RETRY_ATTEMPTS=3
ENABLE_LOCAL_FALLBACK=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
# Only applied to Qwen3 schema-constrained JSON requests; free text is unchanged.
OLLAMA_STRUCTURED_THINKING=false
VIDEO_GENERATION_PROVIDER=auto
CLOUD_VIDEO_MODEL=
ENABLE_LOCAL_VIDEO_RENDERING=true
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Process-local admission wait and maximum in-request retry sleep. Longer delays cool down and fail over.
AI_CLOUD_QUEUE_TIMEOUT_SECONDS=10
AI_MAX_RETRY_WAIT_SECONDS=10

# The exact previously shipped 2.5/3.8/3.7/3.6 chain is migrated in memory
# to 3.6/3.7/3.8; the existing .env and API key are never rewritten.
